# ---------------------------------------------------------------------------
# Core Django configuration
# ---------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=0
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=api.jet5.example.com

# ---------------------------------------------------------------------------
# CORS / CSRF
# ---------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=https://app.jet5.example.com
CSRF_TRUSTED_ORIGINS=https://api.jet5.example.com

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=1
USE_X_FORWARDED_HOST=1
SESSION_COOKIE_SAMESITE=Strict
SESSION_COOKIE_AGE=1209600

# ---------------------------------------------------------------------------
# Database & persistence
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/jet5
DB_CONN_MAX_AGE=120
DB_ATOMIC_REQUESTS=1

# ---------------------------------------------------------------------------
# REST Framework / JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
DRF_USER_THROTTLE=1000/day
DRF_ANON_THROTTLE=100/day

# ---------------------------------------------------------------------------
# File upload limits (bytes)
# ---------------------------------------------------------------------------
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# ---------------------------------------------------------------------------
# Static & media management
# ---------------------------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=/var/www/jet5/static
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/jet5/media
USE_S3_STORAGE=0
# AWS_STORAGE_BUCKET_NAME=jet5-prod
# AWS_S3_REGION_NAME=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=cdn.jet5.example.com
# AWS_STATIC_LOCATION=static
# AWS_MEDIA_LOCATION=media

# ---------------------------------------------------------------------------
# Observability & rate limiting
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
DJANGO_LOG_LEVEL=INFO
AXES_ENABLED=1
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
START_NOTIFICATION_SCHEDULER=1
PROMETHEUS_EXPORT_MIGRATIONS=0

# ---------------------------------------------------------------------------
# Third-party integrations
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+00000000000

